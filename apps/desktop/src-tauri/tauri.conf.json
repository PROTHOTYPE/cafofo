{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Cafofo",
    "version":  "0.1.6",
    "identifier":  "com.cafofo.desktop",
    "build":  {
                  "beforeDevCommand":  "corepack pnpm dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "corepack pnpm build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "Cafofo",
                                    "width":  1280,
                                    "height":  800,
                                    "minWidth":  960,
                                    "minHeight":  600,
                                    "decorations":  false,
                                    "visible":  false,
                                    "resizable":  true,
                                    "shadow":  true
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "publisher":  "Cafofo",
                   "createUpdaterArtifacts":  true,
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ]
               },
