# Cafofo Production Environment Template
# Copie para `.env.production` e preencha com as credenciais reais (NUNCA commitar `.env.production`).

# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Frontend (Vite / Cloudflare Pages)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Preenchido automaticamente pelo script scripts/deploy-cloud.ps1 com a URL do Fly.io:
# VITE_SIGNALING_URL=wss://cafofo-signaling.fly.dev/ws

# LiveKit Cloud
LIVEKIT_URL=wss://seu-projeto.livekit.cloud
LIVEKIT_API_KEY=API_KEY_AQUI
LIVEKIT_API_SECRET=API_SECRET_AQUI

# Cafofo Signaling Server (Axum)
CAFOFO_HOST=0.0.0.0
CAFOFO_PORT=3001
CAFOFO_GRACE_PERIOD_MS=15000
